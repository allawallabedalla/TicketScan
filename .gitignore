# Konfiguration mit echten Werten — siehe .env.example
.env
.env.*
!.env.example
# Enthält nur die öffentliche Adresse der Endpunkte, keine Geheimnisse.
!web/.env.production

# Die echte Ticketliste gehört nicht ins Repo, sie wird direkt importiert.
#
# Breit statt namentlich: Vorher standen hier genau zwei Dateinamen. Ein Export
# als „tickets-final.csv" oder „Herzberg 2027.xlsx" wäre mitgecheckt worden —
# 2305 Namen in einem öffentlichen Repository, und dazwischen liegt nur ein
# Dateiname.
data/*.csv
data/*.xlsx
data/*.xls
!data/tickets.sample.csv
*.csv
!data/tickets.sample.csv

node_modules/
dist/
.DS_Store
web/dist/
web/dev-dist/
# 18 MB Texterkennung — kommen reproduzierbar aus node_modules, siehe
# web/scripts/vendor-ocr.mjs (läuft automatisch vor jedem Build).
web/public/tesseract/
