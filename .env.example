# TicketScan — Konfiguration
#
# Diese Datei dokumentiert nur die NAMEN der Variablen. Echte Werte gehören
# niemals ins Repo: sie werden als Secrets beim Backend hinterlegt
# (Supabase → Project Settings → Edge Functions → Secrets) und lokal in einer
# .env, die von .gitignore ausgeschlossen ist.

# Gemeinsames Eventpasswort. Wird einmal je Gerät und Festivaltag abgefragt,
# nie beim Scannen, und ausschließlich serverseitig in der Edge Function
# `session` geprüft — nie im Browser. Vor dem Festival ersetzen.
TICKETSCAN_EVENT_PASSWORD=

# Zeitzone, in der die Tageswechsel-Stunde gilt. Muss gesetzt sein: Edge
# Functions laufen in UTC, und ohne diese Angabe läge der Wechsel im Sommer
# auf 8 Uhr deutscher Zeit.
TICKETSCAN_TIMEZONE=Europe/Berlin

# Herkunft, die die Endpunkte annehmen. Vor dem Einsatz auf die echte Adresse
# der App setzen; ohne Angabe werden alle Herkünfte zugelassen.
TICKETSCAN_ALLOWED_ORIGIN=

# Stunde des Tageswechsels (in obiger Zeitzone). Das Gerätetoken gilt bis zum
# nächsten Erreichen dieser Uhrzeit, nicht 24 Stunden ab Anmeldung — so fällt
# der Ablauf nie in eine laufende Nachtschicht.
TICKETSCAN_SESSION_ROLLOVER_HOUR=6

# Signierschlüssel für die Gerätetokens. Zufällig erzeugen:
#   openssl rand -base64 48
# Ein Wechsel meldet alle Geräte ab und erzwingt eine neue Anmeldung.
TICKETSCAN_TOKEN_SECRET=

# Supabase-Zugang. Der Service-Role-Schlüssel darf ausschließlich in den
# Edge Functions verwendet werden, niemals im Frontend-Bundle.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Wird ins Frontend gebaut und ist damit öffentlich — das ist so vorgesehen.
# Der Anon-Key allein erlaubt keinen Zugriff auf Tickets oder Einlösungen.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
